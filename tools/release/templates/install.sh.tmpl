#!/bin/sh
# toktrail bootstrap installer for {{.Version}}
#
# TRUST MODEL - read docs/RELEASE.md before using this script:
#   * This script pins the release Ed25519 public key and the SHA-256 of
#     each platform's toktrail-release binary. It must be obtained from a
#     channel you trust (the project repository or official release notes),
#     NEVER from the download mirror that serves the artifacts.
#   * Everything downloaded afterwards is verified before installation:
#     the manifest's detached Ed25519 signature under the pinned public
#     key, then every archive and binary hash, platform and version.
#   * This installer only places the toktrail binary. It does not read or
#     change upload consent or collector state, does not register any
#     scheduler/launch agent, and never contacts the toktrail upload
#     (sync) server. BASE_URL below is the release DOWNLOAD/update
#     endpoint, which must be a separate origin from any upload endpoint.
#   * EXCEPTION: when --connect LINK is given, this script runs the
#     freshly installed 'toktrail connect LINK' once the install above
#     succeeds. That is the only case where this script's own actions
#     lead to a call beyond the signed release download; the connect
#     call itself is made by the installed collector binary under its
#     own command surface, not by this script reaching into the network.
#   * With --upgrade, the script instead runs the pinned installer's
#     'upgrade' subcommand: it only replaces an EXISTING toktrail binary
#     in place (discovered on PATH, or in INSTALL_DIR when given), keeps
#     the previous binary as <binary>.previous, never re-runs connect,
#     and never reads or writes state, grants, outbox or scheduler
#     registration. There is no automatic rollback; see docs/RELEASE.md.
#     --upgrade and --connect are mutually exclusive.
#
# Usage: install-{{.Version}}.sh [BASE_URL [INSTALL_DIR]] [--connect LINK] [--upgrade] [--no-path]
#   BASE_URL      release download root that serves manifest.json et al.
#                 (also via TOKTRAIL_DOWNLOAD_BASE); defaults to the
#                 official GitHub release download root for {{.Version}}
#   INSTALL_DIR   install mode: default $HOME/.toktrail/bin (also via
#                 TOKTRAIL_INSTALL_DIR). upgrade mode: NO default - the
#                 existing binary is discovered on PATH unless a directory
#                 is given explicitly (pass the directory your scheduler
#                 actually invokes if it differs from the PATH match)
#   --connect LINK
#                 optional one-time connect link; after a successful
#                 install, runs 'toktrail connect LINK' using the
#                 absolute path of the binary just installed
#   --upgrade     in-place upgrade of an existing installation only
#   --no-path     never offer to add the install directory to PATH
#                 (also: TOKTRAIL_SKIP_PATH_SETUP=1)
set -eu

VERSION='{{.Version}}'
DEFAULT_BASE_URL='https://github.com/lich0821/toktrail-collector/releases/download/{{.Version}}'

fail() { echo "install: $*" >&2; exit 1; }

BASE_URL_ARG=""
INSTALL_DIR_ARG=""
CONNECT_URL=""
UPGRADE=0
POSITIONAL=0
NO_PATH_SETUP=0
while [ $# -gt 0 ]; do
  case "$1" in
    --connect)
      [ $# -ge 2 ] || fail "--connect requires a URL argument"
      CONNECT_URL="$2"
      [ -n "$CONNECT_URL" ] || fail "--connect requires a non-empty URL argument"
      shift 2
      ;;
    --connect=*)
      CONNECT_URL="${1#--connect=}"
      [ -n "$CONNECT_URL" ] || fail "--connect requires a non-empty URL argument"
      shift
      ;;
    --upgrade)
      UPGRADE=1
      shift
      ;;
    --no-path)
      NO_PATH_SETUP=1
      shift
      ;;
    --*)
      fail "unknown argument: $1"
      ;;
    *)
      case "$POSITIONAL" in
        0) BASE_URL_ARG="$1" ;;
        1) INSTALL_DIR_ARG="$1" ;;
        *) fail "unexpected extra argument: $1" ;;
      esac
      POSITIONAL=$((POSITIONAL + 1))
      shift
      ;;
  esac
done

[ "$UPGRADE" != 1 ] || [ -z "$CONNECT_URL" ] || \
  fail "--upgrade and --connect are mutually exclusive: an upgrade never re-connects or re-binds"

BASE_URL="${BASE_URL_ARG:-${TOKTRAIL_DOWNLOAD_BASE:-$DEFAULT_BASE_URL}}"

if [ "$UPGRADE" = 1 ]; then
  # Upgrade mode must only touch an existing installation, so there is no
  # default install directory: the pinned installer discovers the existing
  # binary on PATH, or uses the explicitly given directory.
  INSTALL_DIR="${INSTALL_DIR_ARG:-${TOKTRAIL_INSTALL_DIR:-}}"
else
  INSTALL_DIR="${INSTALL_DIR_ARG:-${TOKTRAIL_INSTALL_DIR:-$HOME/.toktrail/bin}}"
fi

[ -n "$BASE_URL" ] || fail "usage: $0 [BASE_URL [INSTALL_DIR]] [--connect LINK] [--upgrade]"

case "$(uname -s)/$(uname -m)" in
{{- range .UnixPins}}
{{.Match}}) TOOL_FILE='{{.ToolFile}}'; TOOL_SHA256='{{.Sha256}}' ;;
{{- end}}
*) fail "unsupported platform $(uname -s)/$(uname -m); this release provides:{{range .UnixPins}} {{.OS}}/{{.Arch}}{{end}}" ;;
esac

have_cmd() { command -v "$1" >/dev/null 2>&1; }

fetch() {
  # $1 url, $2 destination
  if have_cmd curl; then curl -fsSL -o "$2" "$1"
  elif have_cmd wget; then wget -q -O "$2" "$1"
  else fail "need curl or wget to download release files"
  fi
}

sha256_of() {
  if have_cmd sha256sum; then sha256sum "$1" | cut -d' ' -f1
  elif have_cmd shasum; then shasum -a 256 "$1" | cut -d' ' -f1
  else fail "need sha256sum or shasum to verify downloads"
  fi
}

TMP="$(mktemp -d 2>/dev/null || fail "mktemp failed")"
cleanup() {
  if [ -n "${TMP:-}" ] && [ -d "$TMP" ]; then
    case "$TMP" in
      /*) rm -rf "$TMP" ;;
    esac
  fi
}
trap cleanup EXIT

echo "==> downloading release tool $TOOL_FILE"
fetch "$BASE_URL/$TOOL_FILE" "$TMP/toktrail-release" || fail "download failed: $BASE_URL/$TOOL_FILE"

ACTUAL="$(sha256_of "$TMP/toktrail-release" || fail "hashing failed")"
if [ "$ACTUAL" != "$TOOL_SHA256" ]; then
  fail "release tool hash mismatch (expected $TOOL_SHA256, got $ACTUAL) - aborting, nothing was installed"
fi
chmod 0755 "$TMP/toktrail-release"

cat > "$TMP/pub.pem" <<'PUBEOF'
{{.PublicKeyPEM}}PUBEOF

if [ "$UPGRADE" = 1 ]; then
  echo "==> verifying release {{.Version}} and upgrading the existing installation"
  if [ -n "$INSTALL_DIR" ]; then
    "$TMP/toktrail-release" upgrade \
      -base-url "$BASE_URL" \
      -version "$VERSION" \
      -pubkey "$TMP/pub.pem" \
      -install-dir "$INSTALL_DIR"
  else
    "$TMP/toktrail-release" upgrade \
      -base-url "$BASE_URL" \
      -version "$VERSION" \
      -pubkey "$TMP/pub.pem"
  fi
else
  echo "==> verifying release {{.Version}} and installing to $INSTALL_DIR"
  "$TMP/toktrail-release" install \
    -base-url "$BASE_URL" \
    -version "$VERSION" \
    -pubkey "$TMP/pub.pem" \
    -install-dir "$INSTALL_DIR"
fi

# PATH setup. Installing into a directory that no shell searches leaves
# `toktrail: command not found` right after a successful install, which reads
# as a broken install. So after an install (never an upgrade) this offers to add
# the directory to the user's shell profile:
#   - it asks on the controlling terminal and DEFAULTS TO YES (empty answer
#     means yes; only an explicit n/no declines);
#   - with no terminal to ask (an unattended `curl | sh`, CI) it proceeds with
#     that same default, and prints exactly what it wrote and how to undo it;
#   - it only ever appends one marked line to the profile for $SHELL, is
#     idempotent (re-running adds nothing), and never rewrites existing lines;
#   - --no-path / TOKTRAIL_SKIP_PATH_SETUP=1 opts out entirely.
# Scheduled collection never needs PATH: the task invokes the binary by
# absolute path.
path_setup_done=0
if [ "$UPGRADE" = 0 ]; then
  ABS_PATH_DIR="$INSTALL_DIR"
  case "$ABS_PATH_DIR" in
    /*) ;;
    *) ABS_PATH_DIR="$(cd "$ABS_PATH_DIR" && pwd)" || ABS_PATH_DIR="$INSTALL_DIR" ;;
  esac
  on_path=0
  old_ifs=$IFS
  IFS=:
  for dir in $PATH; do
    case "$dir" in
      /*) ;;
      *) continue ;;
    esac
    if [ "$(cd "$dir" 2>/dev/null && pwd -P)" = "$(cd "$ABS_PATH_DIR" 2>/dev/null && pwd -P)" ]; then
      on_path=1
    fi
  done
  IFS=$old_ifs

  if [ "$on_path" = 1 ]; then
    path_setup_done=1
  elif [ "${TOKTRAIL_SKIP_PATH_SETUP:-}" = 1 ] || [ "$NO_PATH_SETUP" = 1 ]; then
    echo ""
    echo "note: skipped adding $ABS_PATH_DIR to PATH (--no-path); add it yourself if you want \`toktrail\` in a shell:"
    echo "      export PATH=\"$ABS_PATH_DIR:\$PATH\""
    echo ""
  else
    profile=""
    path_line=""
    case "${SHELL:-}" in
      */zsh)
        profile="$HOME/.zshrc"
        path_line="export PATH=\"$ABS_PATH_DIR:\$PATH\""
        ;;
      */bash)
        if [ "$(uname -s)" = "Darwin" ]; then profile="$HOME/.bash_profile"; else profile="$HOME/.bashrc"; fi
        path_line="export PATH=\"$ABS_PATH_DIR:\$PATH\""
        ;;
      */fish)
        profile="$HOME/.config/fish/config.fish"
        path_line="fish_add_path \"$ABS_PATH_DIR\""
        ;;
      *)
        profile=""
        ;;
    esac
    if [ -z "$profile" ]; then
      echo ""
      echo "note: $ABS_PATH_DIR is not on PATH and \$SHELL (${SHELL:-unset}) is not a shell this script edits."
      echo "      add it to your shell's startup file:  export PATH=\"$ABS_PATH_DIR:\$PATH\""
      echo "      Scheduled collection does not need PATH: the task invokes $ABS_PATH_DIR/toktrail directly."
      echo ""
    else
      already=0
      if [ -f "$profile" ] && grep -F -x -q -- "$path_line" "$profile" 2>/dev/null; then
        already=1
      fi
      if [ "$already" = 1 ]; then
        path_setup_done=1
      else
        answer=""
        if ( : </dev/tty ) 2>/dev/null; then
          # Ask on the terminal, never on stdin: under `curl | sh` stdin is the
          # script itself, so a prompt reading it would consume script text.
          printf 'Add %s to PATH in %s? [Y/n] ' "$ABS_PATH_DIR" "$profile" >/dev/tty 2>/dev/null || true
          if IFS= read -r answer </dev/tty 2>/dev/null; then :; else answer=""; fi
        fi
        case "$answer" in
          n|N|no|No|NO)
            echo ""
            echo "note: left PATH unchanged; add it yourself with:  $path_line"
            echo ""
            ;;
          *)
            mkdir -p -- "$(dirname -- "$profile")" 2>/dev/null || true
            if [ -w "$profile" ] || [ ! -e "$profile" ]; then
              {
                echo ""
                echo "# TokTrail collector: added by $0"
                echo "$path_line"
              } >> "$profile"
              path_setup_done=1
              echo ""
              echo "==> added to PATH in $profile:"
              echo "    $path_line"
              echo "    open a new terminal (or run: . \"$profile\") to use \`toktrail\`"
              echo "    to undo: delete the line above from $profile"
              echo ""
            else
              echo ""
              echo "note: could not write $profile; add it yourself with:  $path_line"
              echo ""
            fi
            ;;
        esac
      fi
    fi
  fi
  if [ "$path_setup_done" = 1 ] && [ "$on_path" = 1 ]; then
    :
  fi
  if [ "$path_setup_done" = 1 ] && [ "$on_path" = 0 ]; then
    echo "note: scheduled collection does not need PATH: the task invokes $ABS_PATH_DIR/toktrail directly."
    echo ""
  fi
fi

if [ -n "$CONNECT_URL" ]; then
  case "$INSTALL_DIR" in
    /*) ABS_INSTALL_DIR="$INSTALL_DIR" ;;
    *) ABS_INSTALL_DIR="$(cd "$INSTALL_DIR" && pwd)" || fail "cannot resolve install directory $INSTALL_DIR" ;;
  esac
  echo "==> connecting with the provided link"
  # This script is normally run as `curl ... | sh`, so OUR stdin is the
  # script itself. A child that reads stdin would consume the remaining
  # script lines (or see EOF), and a confirmation prompt would answer for
  # nobody. Never hand the script pipeline to the collector: give it the
  # controlling terminal when one exists, and an empty stdin otherwise (the
  # collector then reports "no interactive terminal" and names the manual
  # command instead of guessing).
  if ( : </dev/tty ) 2>/dev/null; then
    "$ABS_INSTALL_DIR/toktrail" connect "$CONNECT_URL" </dev/tty
  else
    "$ABS_INSTALL_DIR/toktrail" connect "$CONNECT_URL" </dev/null
  fi
fi
