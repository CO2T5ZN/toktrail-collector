# toktrail bootstrap installer for {{.Version}}
#
# TRUST MODEL - read docs/RELEASE.md before using this script:
#   * This script pins the release Ed25519 public key and the SHA-256 of
#     each platform's toktrail-release.exe. It must be obtained from a
#     channel you trust (the project repository or official release notes),
#     NEVER from the download mirror that serves the artifacts.
#   * Everything downloaded afterwards is verified before installation:
#     the manifest's detached Ed25519 signature under the pinned public
#     key, then every archive and binary hash, platform and version.
#   * This installer only places toktrail.exe. It does not read or change
#     upload consent or collector state, does not register any scheduled
#     task or service, and never contacts the toktrail upload (sync)
#     server. -BaseUrl below is the release DOWNLOAD/update endpoint,
#     which must be a separate origin from any upload endpoint.
#   * EXCEPTION: when -ConnectUrl is given, this script runs the freshly
#     installed 'toktrail.exe connect <ConnectUrl>' once the install
#     above succeeds. That is the only case where this script's own
#     actions lead to a call beyond the signed release download; the
#     connect call itself is made by the installed collector binary
#     under its own command surface, not by this script reaching into
#     the network.
#   * With -Upgrade, the script instead runs the pinned installer's
#     'upgrade' subcommand: it only replaces an EXISTING toktrail.exe in
#     place (discovered on PATH, or in -InstallDir when given), keeps
#     the previous binary as <binary>.previous, never re-runs connect,
#     and never reads or writes state, grants, outbox or scheduler
#     registration. There is no automatic rollback; see docs/RELEASE.md.
#     -Upgrade and -ConnectUrl are mutually exclusive.
#
# Usage:
#   powershell -ExecutionPolicy Bypass -File install-{{.Version}}.ps1 [-BaseUrl <root>] [-InstallDir <dir>] [-ConnectUrl <link>] [-Upgrade]
#   -BaseUrl     release download root that serves manifest.json et al.;
#                defaults to the official GitHub release download root
#                for {{.Version}}
#   -InstallDir  install mode: default $env:USERPROFILE\.toktrail\bin.
#                upgrade mode: NO default - the existing binary is
#                discovered on PATH unless a directory is given explicitly
#                (pass the directory your scheduler actually invokes if it
#                differs from the PATH match)
#   -ConnectUrl  optional one-time connect link; after a successful
#                install, runs 'toktrail.exe connect <ConnectUrl>' using
#                the absolute path of the binary just installed
#   -Upgrade     in-place upgrade of an existing installation only
param(
  [string]$BaseUrl = "https://github.com/lich0821/toktrail-collector/releases/download/{{.Version}}",
  [string]$InstallDir = "$env:USERPROFILE\.toktrail\bin",
  [string]$ConnectUrl = "",
  [switch]$Upgrade,
  [switch]$NoPathSetup
)
$ErrorActionPreference = 'Stop'
$version = '{{.Version}}'

if (-not $BaseUrl) {
  Write-Error "BaseUrl must not be empty"
  exit 1
}

if ($Upgrade -and $ConnectUrl) {
  Write-Error "-Upgrade and -ConnectUrl are mutually exclusive: an upgrade never re-connects or re-binds"
  exit 1
}

# In upgrade mode there is no default install directory: only an explicitly
# given -InstallDir is forwarded, otherwise the pinned installer discovers
# the existing binary on PATH.
$effectiveInstallDir = $InstallDir
if ($Upgrade -and -not $PSBoundParameters.ContainsKey('InstallDir')) {
  $effectiveInstallDir = ""
}

switch ($env:PROCESSOR_ARCHITECTURE) {
{{- range .WinPins}}
  '{{.Arch}}' { $arch = '{{.Arch}}' }
{{- end}}
  default { Write-Error "unsupported architecture $($env:PROCESSOR_ARCHITECTURE)" }
}
$pins = @{
{{- range .WinPins}}
  '{{.Arch}}' = '{{.Sha256}}'
{{- end}}
}
$toolName = "toktrail-release-$version-windows-$arch.exe"
$tmp = New-Item -ItemType Directory -Path (Join-Path $env:TEMP ("toktrail-install-" + [guid]::NewGuid().ToString("N")))
$tool = Join-Path $tmp 'toktrail-release.exe'

try {
  Write-Host "==> downloading release tool $toolName"
  & curl.exe -fsSL -o $tool "$BaseUrl/$toolName"
  if ($LASTEXITCODE -ne 0) {
    $code = $LASTEXITCODE
    Write-Error "download failed: $BaseUrl/$toolName"
    exit $code
  }

  $actual = (Get-FileHash -Algorithm SHA256 -Path $tool).Hash.ToLower()
  if ($actual -ne $pins[$arch]) {
    Write-Error "release tool hash mismatch (expected $($pins[$arch]), got $actual) - aborting, nothing was installed"
    exit 1
  }

  $pub = Join-Path $tmp 'pub.pem'
  $pubKey = @'
{{.PublicKeyPEM}}'@
  [IO.File]::WriteAllText($pub, $pubKey)

  $toolArgs = @('-base-url', $BaseUrl, '-version', $version, '-pubkey', $pub)
  if ($Upgrade) {
    Write-Host "==> verifying release $version and upgrading the existing installation"
    $mode = 'upgrade'
  } else {
    Write-Host "==> verifying release $version and installing to $InstallDir"
    $mode = 'install'
  }
  if ($effectiveInstallDir) {
    $toolArgs += @('-install-dir', $effectiveInstallDir)
  }
  & $tool $mode @toolArgs
  if ($LASTEXITCODE -ne 0) {
    exit $LASTEXITCODE
  }

  # PATH setup. Installing into a directory no shell searches leaves
  # "toktrail is not recognized" right after a successful install. After an
  # install (never an upgrade) this offers to add the directory to the user
  # PATH: it prompts with a YES default, honours an explicit "n", and is
  # idempotent. -NoPathSetup / TOKTRAIL_SKIP_PATH_SETUP=1 opts out. Scheduled
  # collection never needs PATH: the task invokes the exe by absolute path.
  if (-not $Upgrade) {
    $installPath = (Resolve-Path -LiteralPath $InstallDir).Path
    $onPath = $false
    foreach ($dir in @($env:Path -split ';')) {
      if (-not $dir) { continue }
      try {
        $resolved = (Resolve-Path -LiteralPath $dir -ErrorAction Stop).Path
        if ($resolved.TrimEnd([char]'\') -ieq $installPath.TrimEnd([char]'\')) { $onPath = $true }
      } catch { }
    }
    if ($onPath) {
      # nothing to do
    } elseif ($NoPathSetup -or $env:TOKTRAIL_SKIP_PATH_SETUP -eq '1') {
      Write-Host ""
      Write-Host "note: skipped adding $installPath to PATH (-NoPathSetup); add it yourself if you want 'toktrail' in a shell:"
      Write-Host "      `$env:Path = `"$installPath;`$env:Path`""
      Write-Host ""
    } else {
      # Ask only when a human can answer; a non-interactive host (CI, a scheduled
      # task) must fall back to the same default as the POSIX script instead of
      # throwing out of Read-Host and aborting before -ConnectUrl runs.
      $answer = 'y'
      if ([Environment]::UserInteractive) {
        try {
          $answer = Read-Host "Add $installPath to PATH for your user account? [Y/n]"
        } catch {
          $answer = 'y'
        }
      }
      if ($answer -match '^(n|no)$') {
        Write-Host ""
        Write-Host "note: left PATH unchanged; add it yourself with:  `$env:Path = `"$installPath;`$env:Path`""
        Write-Host ""
      } else {
        # Read and write HKCU\Environment directly: GetEnvironmentVariable
        # expands REG_EXPAND_SZ values (%USERPROFILE% is frozen into its current
        # value) and SetEnvironmentVariable writes REG_SZ, which permanently
        # breaks every %VAR% entry in the user PATH. Preserve the raw text and
        # the value kind.
        $envKey = $null
        try {
          # Registry provider Get-Item can return a read-only handle even in an
          # elevated PowerShell. Explicitly request write access instead.
          $envKey = [Microsoft.Win32.Registry]::CurrentUser.OpenSubKey('Environment', $true)
          if ($null -eq $envKey) {
            $envKey = [Microsoft.Win32.Registry]::CurrentUser.CreateSubKey('Environment')
          }
          $userPath = [string]$envKey.GetValue('Path', '', [Microsoft.Win32.RegistryValueOptions]::DoNotExpandEnvironmentNames)
          $alreadyThere = $false
          foreach ($dir in @($userPath -split ';')) {
            if ($dir -and $dir.TrimEnd([char]'\') -ieq $installPath.TrimEnd([char]'\')) { $alreadyThere = $true }
          }
          if ($alreadyThere) {
            Write-Host "==> $installPath is already in your user PATH"
          } else {
            $newPath = if ($userPath) { "$installPath;$userPath" } else { $installPath }
            $kind = [Microsoft.Win32.RegistryValueKind]::ExpandString
            try { if ($envKey.GetValueKind('Path') -eq [Microsoft.Win32.RegistryValueKind]::String) { $kind = [Microsoft.Win32.RegistryValueKind]::String } } catch { }
            $envKey.SetValue('Path', $newPath, $kind)
            Write-Host ""
            Write-Host "==> added to your user PATH: $installPath"
            Write-Host "    open a new terminal to use 'toktrail'"
            Write-Host "    to undo: remove that entry in System Properties > Environment Variables"
            Write-Host ""
          }
        } catch {
          Write-Host ""
          Write-Host "note: could not update your user PATH; installation will continue."
          Write-Host "      add $installPath through System Properties > Environment Variables if you want 'toktrail' in a shell."
          Write-Host ""
        } finally {
          if ($null -ne $envKey) { $envKey.Dispose() }
        }
        $env:Path = "$installPath;$env:Path"
        Write-Host "note: scheduled collection does not need PATH: the task invokes $installPath\toktrail.exe directly."
        Write-Host ""
      }
    }
  }

  if ($ConnectUrl) {
    $installedExe = Join-Path (Resolve-Path $InstallDir) 'toktrail.exe'
    Write-Host "==> connecting with the provided link"
    & $installedExe connect $ConnectUrl
    if ($LASTEXITCODE -ne 0) {
      exit $LASTEXITCODE
    }
  }
}
finally {
  if ($tmp -and (Test-Path $tmp)) {
    Remove-Item -Recurse -Force $tmp
  }
}
